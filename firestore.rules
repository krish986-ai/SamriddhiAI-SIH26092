rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Beneficiary application documents
    match /applications/{applicationId} {
      // Citizens and SCA officers can read applications for triage and status tracking
      allow read: if true;
      // Beneficiaries can create new applications with valid basic fields
      allow create: if request.resource.data.appId is string
                    && request.resource.data.applicantName is string
                    && request.resource.data.requestedAmount is number;
      // Officers / Beneficiaries can update application lifecycle status and notes
      allow update: if true;
      // Prevent unauthorized deletion
      allow delete: if false;
    }
  }
}
